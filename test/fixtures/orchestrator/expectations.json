{
  "apiVersion": "deploykit/failure-expectations/v1alpha1",
  "comment": "Every fixture listed here must be rejected with exactly this frozen DK_* code and recovery action. Phase 1 adds no parser; later phases must satisfy these expectations.",
  "canaries": [
    "DK_CANARY_CERTBOT_EMAIL_5f3a1c",
    "DK_CANARY_DATABASE_URL_9b2e74",
    "DK_CANARY_POSTGRES_PASSWORD_c481ad",
    "DK_CANARY_UNDECLARED_TOKEN_7e11f0",
    "DK_CANARY_LONG_NAME_2c9d55"
  ],
  "canaryBearingFixtures": [
    "ownership/invalid/secret-value-in-marker.json",
    "protocol/invalid/declared-frame-count-mismatch.jsonl",
    "protocol/invalid/duplicate-secret-name.jsonl",
    "protocol/invalid/noncanonical-key-order.jsonl",
    "protocol/invalid/oversized-request-frame.jsonl",
    "protocol/invalid/secret-name-too-long.jsonl",
    "protocol/invalid/trailing-frame.jsonl",
    "protocol/invalid/truncated-stream.jsonl",
    "protocol/invalid/undeclared-secret.jsonl",
    "protocol/invalid/unknown-frame-key.jsonl",
    "protocol/invalid/unknown-operation.jsonl",
    "protocol/invalid/unsupported-protocol-version.jsonl",
    "protocol/valid/apply.jsonl",
    "protocol/valid/retry.jsonl",
    "state/invalid/operation-record-with-secret.json"
