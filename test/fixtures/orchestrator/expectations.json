    {
      "fixture": "config/invalid/invalid-ref.yaml",
      "code": "DK_CONFIG_INVALID",
      "recovery": "edit-config-and-rerun",
      "boundary": "config-schema",
      "violation": "the requested ref contains a path traversal segment"
    },
    {
      "fixture": "config/invalid/non-string-environment-value.yaml",
