    {
      "fixture": "config/invalid/secret-like-frontend-name.yaml",
      "code": "DK_CONFIG_INVALID",
      "recovery": "edit-config-and-rerun",
      "boundary": "config-schema",
      "violation": "a public static-frontend variable is named like a secret and would be embedded in built assets"
