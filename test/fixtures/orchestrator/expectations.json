    {
      "fixture": "config/invalid/placeholder-values.yaml",
      "code": "DK_CONFIG_PLACEHOLDER",
      "recovery": "edit-config-and-rerun",
      "boundary": "config-schema",
      "violation": "the bundled example placeholders were never replaced with real values"
    },
    {
      "fixture": "config/invalid/reserved-deploykit-key.yaml",
      "code": "DK_CONFIG_INVALID",
      "recovery": "edit-config-and-rerun",
      "boundary": "config-schema",
